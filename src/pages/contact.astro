---
import Base from "../layouts/Base.astro";
const GROUP_URL = "https://www.facebook.com/share/g/14jtya1TGU2/";
const EMAIL = "contact@popsupport.org";
---
<Base
  title="Contact the admins"
  description="Send a private message to the admins of the Pelvic Organ Prolapse Support Society."
  current="/contact/"
>
  <div class="narrow">
    <span class="label">Contact</span>
    <h1>Contact the admins</h1>
    <p>
      For questions about prolapse, symptoms or treatment,
      our <a href={GROUP_URL} rel="noopener">Facebook group</a> is the best place
      to ask. Members who have been through it can share what helped them.
    </p>
    <p>
      If you need to reach the group admins privately, use this form.
    </p>

    <p class="privacy-note">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10" width="14" height="10" stroke="currentColor" stroke-width="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2"/></svg>
      Messages go only to the group admins. We can't give medical advice. For anything to do with your health, contact your healthcare provider.
    </p>

    <form
      id="contact"
      class="contact-form"
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="contact" />
      <input type="hidden" name="subject" value="New message from popsupport.org" />
      <p class="visually-hidden" aria-hidden="true">
        <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="field">
        <label for="contact-name">Name <span class="req">(required)</span></label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="contact-email">Email <span class="req">(required)</span></label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="contact-message">Message <span class="req">(required)</span></label>
        <textarea id="contact-message" name="message" rows="7" required></textarea>
      </div>

      <p class="actions">
        <button type="submit" class="btn">Send message</button>
      </p>

      <div id="contact-status" class="form-status" aria-live="polite"></div>
    </form>

    <p class="form-alt">
      Prefer email? <a href={"mailto:" + EMAIL}>{EMAIL}</a>
    </p>
  </div>

  <script is:inline define:vars={{ EMAIL }}>
    (function () {
      var form = document.getElementById("contact");
      if (!form) return;
      var button = form.querySelector('button[type="submit"]');
      var status = document.getElementById("contact-status");

      function show(kind, html) {
        status.className = "form-status form-status--" + kind;
        status.innerHTML = html;
      }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        button.disabled = true;
        button.textContent = "Sending…";
        show("pending", "");

        fetch("/__forms.html", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(new FormData(form)).toString(),
        })
          .then(function (res) {
            if (!res.ok) throw new Error(String(res.status));
            form.reset();
            show("ok", "<p>Thank you. Your message has been sent to the group admins.</p>");
          })
          .catch(function () {
            show(
              "error",
              '<p>Sorry, your message could not be sent. Please try again, or email us at <a href="mailto:' +
                EMAIL + '">' + EMAIL + "</a>.</p>"
            );
          })
          .finally(function () {
            button.disabled = false;
            button.textContent = "Send message";
          });
      });
    })();
  </script>
</Base>
